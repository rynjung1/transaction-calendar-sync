# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Plaid (Dashboard > Team Settings > Keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Publicly reachable URL for this backend's webhook endpoint, e.g.
# https://your-backend.vercel.app/api/plaid/webhook
PLAID_WEBHOOK_URL=

# 32 raw bytes, base64-encoded — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
