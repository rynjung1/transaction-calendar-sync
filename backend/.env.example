# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Plaid (Dashboard > Team Settings > Keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Publicly reachable URL for this backend's webhook endpoint, e.g.
# https://your-backend.vercel.app/api/plaid/webhook
PLAID_WEBHOOK_URL=

# Optional — only needed for Plaid OAuth support (several major Canadian
# banks require it). Leave unset until you've registered a redirect URI in
# the Plaid Dashboard (Team Settings > API > Allowed redirect URIs) AND set
# up the corresponding iOS Associated Domains config (see
# mobile/app.config.ts, backend/.well-known/apple-app-site-association).
# e.g. https://your-backend.vercel.app/plaid-oauth-return
PLAID_REDIRECT_URI=

# 32 raw bytes, base64-encoded — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
